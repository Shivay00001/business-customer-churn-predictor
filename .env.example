# Copy to .env and fill in real values. Never commit .env.
#
# Generate an API key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Shared-secret API key (required, min 16 chars). Server refuses to start without it.
API_KEY=change-me-to-a-64-char-random-string

# Path to the trained model artifact (relative to repo root or absolute).
MODEL_PATH=models/churn_v1.pkl

# Comma-separated allowed CORS origins, e.g. https://app.example.com
# Empty = same-origin only (most restrictive).
ALLOWED_ORIGINS=

# Port for local runs (Render sets this itself).
PORT=8000

# Set to true to enable /docs and /redoc. Keep false in production.
DEBUG=false
